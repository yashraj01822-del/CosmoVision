* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
}

body {
  background: #020419;
  color: #e8efff;
  font-family: Inter, system-ui, -apple-system, sans-serif;
}

button {
  font: inherit;
  cursor: pointer;
}

.app {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 50% 45%,
      #16245d 0%,
      #070b2d 42%,
      #010211 100%
    );
}

/* SKY MAP */

.sky-map {
  position: absolute;
  inset: 0;
  overflow: hidden;
  touch-action: none;
  user-select: none;
}

.sky-map-stars {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.sky-star {
  position: absolute;
  width: 2px;
  height: 2px;
  border-radius: 50%;
  background: white;
  box-shadow: 0 0 7px #b8d0ff;
}

/* CLOUDS */

.sky-cloud-layer {
  position: absolute;
  z-index: 3;
  inset: 0 0 45% 0;
  pointer-events: none;
  overflow: hidden;
  transition: opacity 0.5s ease;
}

.sky-cloud {
  position: absolute;
  border-radius: 50%;
  background: rgba(170, 185, 215, 0.75);
  filter: blur(22px);
}

.cloud-a {
  width: 60%;
  height: 45%;
  left: -10%;
  top: 5%;
}

.cloud-b {
  width: 65%;
  height: 40%;
  left: 25%;
  top: 15%;
}

.cloud-c {
  width: 55%;
  height: 38%;
  right: -10%;
  top: 0;
}

/* OBJECTS */

.sky-objects {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.sky-object {
  position: absolute;
  transform: translate(-50%, -50%);
  text-align: center;
  color: #cbd8f5;
  font-size: 10px;
  text-shadow: 0 2px 8px black;
}

.sky-object-dot {
  width: 8px;
  height: 8px;
  margin: auto auto 4px;
  border-radius: 50%;
  background: white;
  box-shadow: 0 0 15px #c9ddff;
}

.sky-object.star .sky-object-dot {
  width: 6px;
  height: 6px;
}

.sky-object.planet .sky-object-dot {
  width: 11px;
  height: 11px;
}

.sky-object.moon .sky-object-dot {
  width: 17px;
  height: 17px;
  background: #e9eeff;
  box-shadow: 0 0 22px #d9e5ff;
}

.sky-object.star .sky-object-label {
  display: none;
}

/* DIRECTIONS */

.sky-direction {
  position: absolute;
  z-index: 5;
  color: #91a8d5;
  font-size: 11px;
  pointer-events: none;
}

.north {
  top: 15%;
  left: 50%;
  transform: translateX(-50%);
}

.east {
  top: 52%;
  right: 10%;
}

.south {
  bottom: 20%;
  left: 50%;
  transform: translateX(-50%);
}

.west {
  top: 52%;
  left: 10%;
}

/* RETICLE */

.sky-reticle {
  position: absolute;
  z-index: 8;
  left: 50%;
  top: 53%;
  width: 95px;
  height: 95px;
  transform: translate(-50%, -50%);
  border: 1px solid rgba(190, 215, 255, 0.75);
  border-radius: 50%;
  pointer-events: none;
}

.sky-reticle::before,
.sky-reticle::after {
  content: "";
  position: absolute;
  background: rgba(190, 215, 255, 0.7);
}

.sky-reticle::before {
  width: 125px;
  height: 1px;
  left: -15px;
  top: 47px;
}

.sky-reticle::after {
  width: 1px;
  height: 125px;
  left: 47px;
  top: -15px;
}

.sky-reticle span {
  position: absolute;
  top: 105px;
  left: 50%;
  transform: translateX(-50%);
  color: #8097c5;
  font-size: 9px;
}

/* TOP BAR */

.top-bar {
  position: absolute;
  z-index: 20;
  top: 16px;
  left: 16px;
  right: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.compass-button,
.cloud-status {
  border: 1px solid rgba(160, 185, 240, 0.25);
  background: rgba(8, 14, 48, 0.7);
  color: #dce7ff;
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
}

.compass-button {
  width: 48px;
  height: 48px;
  border-radius: 50%;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand strong {
  font-size: 19px;
  font-weight: 500;
}

.brand span {
  margin-top: 3px;
  font-size: 8px;
  letter-spacing: 0.2em;
  color: #7d91bd;
}

.cloud-status {
  display: flex;
  gap: 6px;
  align-items: center;
  padding: 11px 15px;
  border-radius: 22px;
}

/* WEATHER PANEL */

.weather-panel {
  position: absolute;
  z-index: 20;
  left: 50%;
  bottom: 18px;
  width: min(560px, calc(100% - 32px));
  transform: translateX(-50%);
  padding: 14px;
  border: 1px solid rgba(150, 180, 235, 0.16);
  border-radius: 20px;
  background: rgba(5, 9, 34, 0.78);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.weather-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
  font-size: 9px;
  letter-spacing: 0.12em;
  color: #7388b4;
}

.weather-header strong {
  color: #bcd4ff;
}

.weather-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10px;
}

.weather-grid div {
  display: flex;
  flex-direction: column;
}

.weather-grid small {
  color: #647ba8;
  font-size: 7px;
}

.weather-grid strong {
  margin-top: 4px;
  font-size: 12px;
}

.cloud-meter {
  margin-top: 12px;
}

.cloud-meter-label {
  display: flex;
  justify-content: space-between;
  color: #8196c1;
  font-size: 9px;
}

.cloud-meter-track {
  height: 4px;
  margin-top: 6px;
  overflow: hidden;
  border-radius: 5px;
  background: rgba(150, 180, 230, 0.12);
}

.cloud-meter-fill {
  height: 100%;
  border-radius: inherit;
  background: #bcd6ff;
  transition: width 0.5s ease;
}

/* SETTINGS */

.settings-button {
  position: absolute;
  z-index: 40;
  right: 16px;
  bottom: 105px;
  width: 46px;
  height: 46px;
  border: 1px solid rgba(160, 185, 240, 0.25);
  border-radius: 50%;
  background: rgba(8, 14, 48, 0.8);
  color: #dce7ff;
}

.settings-panel,
.object-panel {
  position: absolute;
  z-index: 50;
  right: 16px;
  bottom: 160px;
  width: min(340px, calc(100% - 32px));
  padding: 20px;
  border: 1px solid rgba(160, 185, 240, 0.2);
  border-radius: 20px;
  background: rgba(7, 12, 42, 0.94);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 20px 70px rgba(0, 0, 0, 0.5);
}

.settings-header,
.object-panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.settings-header small,
.object-panel-header small {
  color: #7288b5;
  font-size: 8px;
  letter-spacing: 0.12em;
}

.settings-header h2,
.object-panel-header h2 {
  margin: 5px 0 0;
  font-size: 20px;
}

.settings-header button,
.object-panel-header button {
  border: 0;
  background: transparent;
  color: #dce7ff;
  font-size: 25px;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom: 1px solid rgba(160, 185, 240, 0.1);
}

.setting-row span {
  display: flex;
  flex-direction: column;
}

.setting-row small {
  margin-top: 3px;
  color: #7288b5;
}

.motion-button {
  width: 100%;
  margin-top: 15px;
  padding: 12px;
  border: 0;
  border-radius: 12px;
  background: #bfd6ff;
  color: #07102e;
  font-weight: 700;
}

.settings-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 16px;
}

.settings-stats div {
  padding: 10px;
  border-radius: 10px;
  background: rgba(130, 160, 220, 0.08);
}

.settings-stats span {
  display: block;
  color: #657da9;
  font-size: 7px;
}

.settings-stats strong {
  display: block;
  margin-top: 4px;
  font-size: 12px;
}

.settings-note {
  color: #8194bd;
  font-size: 11px;
  line-height: 1.5;
}

/* OBJECT PANEL */

.object-type {
  display: inline-block;
  margin: 12px 0;
  padding: 5px 9px;
  border-radius: 8px;
  background: rgba(140, 170, 230, 0.1);
  color: #a9c4f2;
  font-size: 9px;
  text-transform: uppercase;
}

.object-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.object-details div {
  padding: 10px;
  border-radius: 10px;
  background: rgba(130, 160, 220, 0.08);
}

.object-details span {
  display: block;
  color: #657da9;
  font-size: 7px;
}

.object-details strong {
  display: block;
  margin-top: 4px;
  font-size: 11px;
}

/* LOADING */

.loading {
  position: absolute;
  z-index: 100;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  background: rgba(1, 3, 20, 0.78);
  backdrop-filter: blur(5px);
  color: #b8c9ec;
  font-size: 12px;
}

.loader {
  width: 32px;
  height: 32px;
  border: 2px solid rgba(180, 200, 240, 0.2);
  border-top-color: #c5dcff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ERROR */

.error {
  position: absolute;
  z-index: 110;
  left: 50%;
  bottom: 90px;
  width: max-content;
  max-width: calc(100% - 32px);
  transform: translateX(-50%);
  padding: 10px 15px;
  border-radius: 12px;
  background: rgba(80, 20, 30, 0.85);
  color: #ffdce1;
  font-size: 11px;
  text-align: center;
}

/* MOBILE */

@media (max-width: 600px) {
  .top-bar {
    top: 10px;
    left: 10px;
    right: 10px;
  }

  .brand strong {
    font-size: 16px;
  }

  .weather-panel {
    bottom: 10px;
    width: calc(100% - 20px);
  }

  .weather-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .settings-button {
    right: 10px;
    bottom: 150px;
  }

  .settings-panel,
  .object-panel {
    right: 10px;
    bottom: 205px;
    width: calc(100% - 20px);
  }
}
